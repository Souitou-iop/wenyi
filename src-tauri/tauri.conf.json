{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wenyi",
  "version": "0.1.0",
  "identifier": "com.wenyi.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../desktop run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../desktop run build",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wenyi",
        "width": 1180,
        "height": 780,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "resources": [
      "../dist/binaries/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
